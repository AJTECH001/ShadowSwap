{
  "name": "shadowswap",
  "version": "1.0.0",
  "description": "Privacy-Preserving DEX with MEV Protection and Encrypted Order Matching - Uniswap v4 Hook + Fhenix FHE",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "test:gas": "forge test --gas-report",
    "build": "forge build",
    "clean": "forge clean",
    "deploy:local": "forge script script/Deploy.s.sol:DeployShadowSwap --sig 'deployLocal()' --broadcast",
    "deploy:sepolia": "forge script script/Deploy.s.sol:DeployShadowSwap --sig 'deploySepolia()' --rpc-url $SEPOLIA_RPC_URL --broadcast",
    "deploy:arb-sepolia": "forge script script/Deploy.s.sol:DeployShadowSwap --sig 'deployArbitrumSepolia()' --rpc-url $ARBITRUM_SEPOLIA_RPC_URL --broadcast",
    "hardhat:test": "npx hardhat test",
    "hardhat:compile": "npx hardhat compile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJTECH001/ShadowSwap.git"
  },
  "keywords": [
    "defi",
    "dex",
    "uniswap",
    "v4",
    "hooks",
    "mev",
    "fhe",
    "fhenix",
    "privacy",
    "ethereum",
    "solidity"
  ],
  "author": "Alade Jamiu Damilola",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AJTECH001/ShadowSwap/issues"
  },
  "homepage": "https://github.com/AJTECH001/ShadowSwap#readme",
  "devDependencies": {
    "@fhenixprotocol/cofhe-contracts": "^0.0.13",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "dotenv": "^17.2.3",
    "fhenix-hardhat-plugin": "^0.3.2",
    "fhenixjs": "^0.4.1",
    "hardhat": "^2.28.3",
    "hardhat-deploy": "^1.0.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@uniswap/sdk-core": "^7.10.1",
    "@uniswap/v4-sdk": "^1.25.2"
  }
}
